# Copy this file to .env and fill in your Angel One credentials.
# The demo CLI (cmd/marketconnector) loads it automatically.
CLIENT_CODE=your-client-code
API_KEY=your-api-key
PASSWORD=your-password

# Either provide a ready TOTP code...
TOTP=123456
# ...or a TOTP secret and the code will be generated for you.
TOTP_SECRET=
