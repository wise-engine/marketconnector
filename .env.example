# Copy this file to .env and fill in your credentials.
# The demo CLI (cmd/marketconnector) loads .env automatically.
#
# Broker to use: angelone | zerodha
BROKER=angelone

# ---- Angel One (BROKER=angelone) — creds from smartapi.angelone.in ----
CLIENT_CODE=your-client-code
API_KEY=your-angelone-api-key
PASSWORD=your-angelone-password
TOTP=123456          # ready code, or set TOTP_SECRET below to auto-generate
TOTP_SECRET=your-totp-secret

# ---- Zerodha Kite (BROKER=zerodha) — creds from developers.kite.trade ----
# Redirect URL registered in Kite must be: http://localhost:8080/api/user/callback/kite/
ZERODHA_API_KEY=your-kite-api-key
ZERODHA_API_SECRET=your-kite-api-secret
